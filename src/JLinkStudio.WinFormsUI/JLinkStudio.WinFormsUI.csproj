<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JLinkStudio.Core\JLinkStudio.Core.csproj" />
    <ProjectReference Include="..\JLinkStudio.SkillGateway\JLinkStudio.SkillGateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WinForms" Version="5.0.55" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>JLink-Studio-Pro</Product>
    <Company>潜龙勿用</Company>
    <!-- 与 JLinkStudio.Core.AppInfo.DisplayVersion 保持一致 -->
    <InformationalVersion>V1.00.001.R</InformationalVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同时作为资源嵌入，供窗体标题栏 / 任务栏显式使用 -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="JLinkStudio.app.ico" />
  </ItemGroup>

</Project>